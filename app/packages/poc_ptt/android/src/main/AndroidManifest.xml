<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Talkgroup announcement: lets the app see the device's text-to-speech engine. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
    </queries>
    <application>
        <!-- Lets the PTT key work while the app is in the background or the
             screen is locked. The user switches it on in Accessibility settings;
             it only filters key events and reads nothing on screen. -->
        <service
            android:name="org.tetra.poc_ptt.PocPttKeyService"
            android:label="@string/poc_ptt_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/poc_ptt_key_service"/>
        </service>
    </application>
</manifest>
